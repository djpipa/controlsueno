rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el usuario "diego" (usuario y contraseña de Firebase) puede leer y escribir.
    function permitido() {
      return request.auth != null
        && request.auth.token.email == 'diego@controlsueno-dfe65.firebaseapp.com';
    }
    match /eventos/{id} {
      allow read, write: if permitido();
    }
  }
}
