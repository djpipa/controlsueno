rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo estas cuentas de Google pueden leer y escribir. Cambiá los correos por los de ustedes.
    function permitido() {
      return request.auth != null
        && request.auth.token.email in ['tu-correo@gmail.com', 'correo-de-tu-pareja@gmail.com'];
    }
    match /eventos/{id} {
      allow read, write: if permitido();
    }
  }
}
